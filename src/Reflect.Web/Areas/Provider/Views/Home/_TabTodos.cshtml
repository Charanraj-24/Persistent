@model DashboardTodosTabViewModel

<div class="card custom-card">
    <div class="card-header">
        <div class="card-title"><i class="ri-money-dollar-circle-line me-1" aria-hidden="true"></i>RTM to-dos before month end</div>
        <span class="text-muted fs-12">@TextFormat.Count(Model.DaysLeftInMonth, "day") left. Blockers first, then closest to a threshold.</span>
    </div>
    <div class="card-body">
        @if (Model.Todos.Count == 0)
        {
            <div class="rpd-empty"><i class="ri-checkbox-circle-line" aria-hidden="true"></i>Nothing left to do this month.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered align-middle rpd-dt w-100" data-order='[]' data-page-length="25">
                    <thead><tr><th>Client</th><th>Status</th><th>Next step</th><th>Actions</th></tr></thead>
                    <tbody>
                        @foreach (var o in Model.Todos)
                        {
                            <tr>
                                <td data-order="@o.Name"><div class="d-flex align-items-center gap-2"><span class="avatar avatar-sm avatar-rounded">@o.Initials</span><span class="fw-semibold">@o.Name</span></div></td>
                                <td><partial name="_Badge" model="o.Badge" /></td>
                                <td class="fs-13">@o.Message</td>
                                <td><a class="btn btn-sm btn-primary-light text-nowrap" href="@Url.Action("Details", "Clients", new { id = o.ClientId })#tab-rtm">Open<span class="visually-hidden"> @o.Name</span></a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
