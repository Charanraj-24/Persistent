@model TimeEntryCreateViewModel
@using Reflect.Domain.Entities.ProviderDashboard
@{
    var isLive = Model.Activity == RtmActivityType.InteractiveCommunication;
    ViewData["Title"] = isLive ? "Log live interaction" : "Add treatment time";
    ViewData["BreadcrumbParent"] = Model.ClientName;
    ViewData["BreadcrumbParentUrl"] = Url.Action("Details", "Clients", new { id = Model.ClientId });
}
@section Styles { <partial name="_ProviderStyles" /> }

<div class="rpd-page-header">
    <div>
        <h1 class="page-title mb-1">@ViewData["Title"]</h1>
        <p class="text-muted fs-13 mb-0">For @Model.ClientName. Manual entries are attested when you save them.</p>
    </div>
</div>

<div class="card custom-card" style="max-width: 48rem;">
    <div class="card-header"><div class="card-title">Time entry</div></div>
    <div class="card-body">
        <form asp-action="Create" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="ClientId" />
            <input type="hidden" asp-for="ClientName" />
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="Activity" class="form-label"></label>
                    <select asp-for="Activity" asp-items="Model.ActivityOptions" class="form-select"></select>
                    <span asp-validation-for="Activity" class="text-danger fs-12"></span>
                </div>
                <div class="col-12 col-md-6" id="modeGroup">
                    <label asp-for="CommunicationMode" class="form-label"></label>
                    <select asp-for="CommunicationMode" asp-items="Model.ModeOptions" class="form-select"></select>
                    <span asp-validation-for="CommunicationMode" class="text-danger fs-12"></span>
                    <div class="rpd-note mt-1">Video, phone, or in person counts as the monthly live interaction.</div>
                </div>
                <div class="col-12 col-sm-6 col-md-4">
                    <label asp-for="Date" class="form-label"></label>
                    <input asp-for="Date" type="date" class="form-control" />
                    <span asp-validation-for="Date" class="text-danger fs-12"></span>
                </div>
                <div class="col-12 col-sm-6 col-md-4">
                    <label asp-for="StartTime" class="form-label"></label>
                    <input asp-for="StartTime" type="time" class="form-control" />
                    <span asp-validation-for="StartTime" class="text-danger fs-12"></span>
                </div>
                <div class="col-12 col-md-4">
                    <label asp-for="Minutes" class="form-label"></label>
                    <input asp-for="Minutes" type="number" min="1" max="120" class="form-control" />
                    <span asp-validation-for="Minutes" class="text-danger fs-12"></span>
                </div>
                <div class="col-12">
                    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-2">
                        <label asp-for="Note" class="form-label mb-0"></label>
                        <button type="button" class="btn btn-sm btn-outline-secondary js-draft-note" data-url="@Url.Action("DraftNote", "Assistant")"><i class="ri-sparkling-2-line me-1" aria-hidden="true"></i>Draft from client data</button>
                    </div>
                    <textarea asp-for="Note" rows="5" maxlength="1000" class="form-control" placeholder="What did you review or discuss, and what changed in the plan?"></textarea>
                    <div class="rpd-note mt-1 js-draft-status" aria-live="polite"></div>
                    <span asp-validation-for="Note" class="text-danger fs-12"></span>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="Attest" class="form-check-input" type="checkbox" />
                        <label asp-for="Attest" class="form-check-label"></label>
                    </div>
                    <span asp-validation-for="Attest" class="text-danger fs-12"></span>
                </div>
            </div>
            <div class="rpd-page-actions mt-4">
                <button type="submit" class="btn btn-primary"><i class="ri-save-line me-1" aria-hidden="true"></i>Save entry</button>
                <a class="btn btn-outline-secondary" href="@Url.Action("Details", "Clients", new { id = Model.ClientId })#tab-rtm">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/assets/libs/jquery-validation/jquery.validate.min.js"></script>
    <script src="~/assets/libs/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/services/provider/timeEntryService.js" asp-append-version="true"></script>
    <script src="~/js/controllers/provider/timeEntryCreateController.js" asp-append-version="true"></script>
    <script nonce="@Context.GetCspNonce()">
        TimeEntryCreateController.init({
            activityId: 'Activity', modeGroupId: 'modeGroup',
            liveValue: @((int)RtmActivityType.InteractiveCommunication),
            noneValue: @((int)CommunicationMode.None),
            defaultLiveMode: @((int)CommunicationMode.Video),
            clientId: '@Model.ClientId',
            token: document.querySelector('input[name="__RequestVerificationToken"]').value
        });
    </script>
}
