@using Reflect.Web.Standins.Security
@{
    var nonce = Context.GetCspNonce();
}
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="robots" content="noindex" />
<meta name="theme-color" content="#1F305E" />
<script nonce="@nonce">
    (function () { try { var t = window.localStorage.getItem('reflect-theme'); if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme-mode', t); } catch (e) { } })();
</script>
<link rel="stylesheet" href="~/assets/libs/bootstrap/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/assets/libs/remixicon/remixicon.css" />
<link rel="stylesheet" href="~/standins/css/theme-standin.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/checkin.css" asp-append-version="true" />
